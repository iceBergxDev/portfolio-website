{
  "name": "nextjs-scaffold",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.0.9",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:content": "node --test tests/content-contract.test.mjs",
    "test:e2e": "node --test --test-reporter=dot --test-concurrency=1 \"tests/e2e/**/*.test.mjs\""
  },
  "dependencies": {
    "framer-motion": "^12.40.0",
    "next": "16.3.5",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.12.4"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.6.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "postcss": "^8.5.28",
    "puppeteer": "25.3.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "puppeteer",
      "unrs-resolver"
